{
  "name": "ak-rica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "update:all": "pnpm run \"/^update:(?!all)/\" --parallel && pnpm generate:summary",
    "update:avatars": "pnpm tsx --tsconfig ./tsconfig.node.json ./scripts/avatars.ts",
    "update:icons": "pnpm tsx --tsconfig ./tsconfig.node.json ./scripts/icons.ts",
    "update:operators": "pnpm tsx --tsconfig ./tsconfig.node.json ./scripts/operators.ts",
    "update:buffs": "pnpm tsx --tsconfig ./tsconfig.node.json ./scripts/buffs.ts",
    "generate:summary": "pnpm tsx --tsconfig ./tsconfig.node.json ./scripts/utils/summary.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
